 };
 
+/*
+    Sizes measured during one layout of a document, for reuse (rush2-recomp patch).
+
+    Flex containers format each item up to three times: to measure its base size, to measure its cross size, then for
+    real. Nested flex containers multiply that, so a page of rows in columns in flex containers formatted every row
+    hundreds of times per layout. A measurement depends only on the element and the sizes it was measured with, and
+    nothing in the document changes during a layout, so the same measurement gives the same size: it is kept here and
+    reused. Only measurements are kept; every element is still formatted for real by its container, so the boxes and
+    offsets it ends up with are what they were without the cache. Active while a LayoutEngine::FormatElement runs.
+*/
+class LayoutMeasureCache {
+public:
+	enum class Kind { ShrinkToFitWidth, FlexBaseHeight, FlexCrossHeight };
+
+	// Holds the cache open for the layout of a document, and empties it after.
+	class Scope {
+	public:
+		Scope();
+		~Scope();
+	};
+
+	// A measurement of the element of this kind with these input sizes, if one was made during this layout.
+	static bool Find(Element* element, Kind kind, Vector2f a, Vector2f b, Vector2f c, float& value);
+	static void Store(Element* element, Kind kind, Vector2f a, Vector2f b, Vector2f c, float value);
+};
+
 } // namespace Rml
 #endif
