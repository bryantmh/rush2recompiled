+namespace {
+	struct SvgTextureKey {
+		String path;
+		Vector2i size;
+		RenderManager* render_manager;
+		bool operator==(const SvgTextureKey& other) const
+		{
+			return path == other.path && size == other.size && render_manager == other.render_manager;
+		}
+	};
+	struct SvgTextureKeyHash {
+		size_t operator()(const SvgTextureKey& key) const
+		{
+			return std::hash<String>()(key.path) ^ (std::hash<int>()(key.size.x) * 31) ^ (std::hash<int>()(key.size.y) * 131) ^
