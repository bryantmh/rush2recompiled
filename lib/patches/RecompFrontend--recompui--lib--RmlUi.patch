+namespace {
+	struct MeasureKey {
+		Element* element;
+		int kind;
+		float sizes[6];
+		bool operator==(const MeasureKey& other) const
+		{
+			return element == other.element && kind == other.kind && std::memcmp(sizes, other.sizes, sizeof(sizes)) == 0;
+		}
+	};
+	struct MeasureKeyHash {
+		size_t operator()(const MeasureKey& key) const
+		{
+			size_t h = std::hash<const void*>()(key.element) ^ (size_t(key.kind) * 0x9E3779B97F4A7C15ull);
+			for (float f : key.sizes)
+			{
+				uint32_t bits;
+				std::memcpy(&bits, &f, sizeof(bits));
+				h = (h ^ bits) * 0x100000001B3ull;
+			}
+			return h;
+		}
+	};
+	// Per thread: each thread lays out its own contexts.
+	thread_local int measure_cache_depth = 0;
+	thread_local std::unordered_map<MeasureKey, float, MeasureKeyHash> measure_cache;
+
+	MeasureKey MakeMeasureKey(Element* element, LayoutMeasureCache::Kind kind, Vector2f a, Vector2f b, Vector2f c)
+	{
+		return MeasureKey{element, int(kind), {a.x, a.y, b.x, b.y, c.x, c.y}};
+	}
+} // namespace
+
+LayoutMeasureCache::Scope::Scope()
+{
+	measure_cache_depth++;
+}
+
+LayoutMeasureCache::Scope::~Scope()
+{
+	if (--measure_cache_depth == 0)
+		measure_cache.clear();
+}
+
+bool LayoutMeasureCache::Find(Element* element, Kind kind, Vector2f a, Vector2f b, Vector2f c, float& value)
+{
+	if (measure_cache_depth == 0)
+		return false;
+	auto it = measure_cache.find(MakeMeasureKey(element, kind, a, b, c));
+	if (it == measure_cache.end())
+		return false;
+	value = it->second;
+	return true;
+}
+
+void LayoutMeasureCache::Store(Element* element, Kind kind, Vector2f a, Vector2f b, Vector2f c, float value)
+{
+	if (measure_cache_depth > 0)
+		measure_cache[MakeMeasureKey(element, kind, a, b, c)] = value;
+}
+
 } // namespace Rml
