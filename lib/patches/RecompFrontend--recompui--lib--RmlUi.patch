+	std::unordered_map<SvgTextureKey, SharedPtr<CallbackTexture>, SvgTextureKeyHash> shared_textures;
+	// Past this many textures, the ones no element shows any more are released when another is made (sizes change with
+	// the window's).
+	constexpr size_t shared_texture_limit = 256;
+} // namespace
+
+void ElementSVG::ReleaseSharedResources()
+{
+	shared_textures.clear();
+	shared_documents.clear();
+}
