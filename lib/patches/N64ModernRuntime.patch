+// Opens mods added to the folder since the last scan without closing the open ones (code mods may be running from
+// them), appends them to the order, and enables the new ones the way load_mods_config does: listed as enabled in the
+// mods config, or unknown to it and enabled by default. Mid-game, enable_mod skips what can't start then (code mods)
+// and runs the content callbacks for the rest (texture packs).
+std::vector<recomp::mods::ModOpenErrorDetails> recomp::mods::ModContext::scan_new_mods(const std::filesystem::path& mod_folder) {
+    size_t first_new = opened_mods.size();
+    std::vector<ModOpenErrorDetails> ret = scan_mod_folder(mod_folder, true);
+    if (opened_mods.size() == first_new) {
+        return ret;
+    }
+    rebuild_mod_order_lookup();
+
+    std::unordered_set<std::string> config_enabled_mods;
+    std::vector<std::string> config_mod_order;
+    std::string config_game_mode;
+    parse_mods_config(mods_config_path, config_game_mode, config_enabled_mods, config_mod_order);
+    for (size_t i = first_new; i < opened_mods.size(); i++) {
+        const std::string mod_id = opened_mods[i].manifest.mod_id;
+        bool known = std::find(config_mod_order.begin(), config_mod_order.end(), mod_id) != config_mod_order.end();
+        if (config_enabled_mods.contains(mod_id) || (!known && opened_mods[i].manifest.enabled_by_default)) {
+            enable_mod(mod_id, true, false);
+        }
+    }
+    return ret;
+}
