+// Turbo (see ultramodern.hpp): how many times the game has gone idle, and the count when the last VI was sent.
+void turbo_set_time(int64_t micros);
+static std::atomic<uint64_t> turbo_idles{ 0 };
+static uint64_t turbo_idles_at_vi = 0;
+static std::mutex turbo_mutex;
+static std::condition_variable turbo_cv;
+
+void ultramodern::turbo_idle() {
+    turbo_idles.fetch_add(1, std::memory_order_acq_rel);
+    turbo_cv.notify_one();
+}
+
+// Blocks until the game has gone idle since the last VI (every game thread has done its work and waits), or 50 ms
+// pass (a game waiting on a timer or the RSP goes idle without finishing; the next VI lets it carry on).
+static void turbo_wait_ready() {
+    using namespace std::chrono_literals;
+    std::unique_lock lock{ turbo_mutex };
+    turbo_cv.wait_for(lock, 50ms, [] { return turbo_idles.load(std::memory_order_acquire) > turbo_idles_at_vi; });
+    turbo_idles_at_vi = turbo_idles.load(std::memory_order_acquire);
+}
