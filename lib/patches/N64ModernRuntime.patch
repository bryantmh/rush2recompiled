+// The fields every mod.json is meant to have. A missing or malformed one no longer rejects the mod: it gets a default
+// and a warning (ModManifest::manifest_warnings) so the mod still shows up and its author sees what to fix.
+static std::string json_type_name(const nlohmann::json& val) {
+    return std::string{val.type_name()};
+}
+
+// default_desc names a default filled in later (an empty default_value), e.g. "the file name".
+static void get_string_or_default(std::string& out, const nlohmann::json& data, const std::string& key, const std::string& default_value,
+    std::vector<std::string>& warnings, const std::string& default_desc = "") {
+    std::string using_default = !default_value.empty() ? ", using \"" + default_value + "\"" : !default_desc.empty() ? ", using " + default_desc : "";
+    auto find_it = data.find(key);
+    if (find_it == data.end()) {
+        warnings.emplace_back("mod.json is missing \"" + key + "\"" + using_default);
+        out = default_value;
+    }
+    else if (!find_it->is_string()) {
+        warnings.emplace_back("\"" + key + "\" in mod.json should be a string, not " + json_type_name(*find_it) + using_default);
+        out = default_value;
+    }
+    else {
+        out = find_it->get<std::string>();
+    }
+}
+
+static void get_version_or_default(recomp::Version& out, const nlohmann::json& data, const std::string& key, std::vector<std::string>& warnings) {
+    out = recomp::Version{0, 0, 0};
+    auto find_it = data.find(key);
+    if (find_it == data.end()) {
+        warnings.emplace_back("mod.json is missing \"" + key + "\", using 0.0.0");
+    }
+    else if (!find_it->is_string()) {
+        warnings.emplace_back("\"" + key + "\" in mod.json should be a version string like \"1.0.0\", using 0.0.0");
+    }
+    else if (!recomp::Version::from_string(find_it->get<std::string>(), out)) {
+        warnings.emplace_back("\"" + key + "\" in mod.json is \"" + find_it->get<std::string>() + "\", not a version like \"1.0.0\", using 0.0.0");
+        out = recomp::Version{0, 0, 0};
+    }
+}
