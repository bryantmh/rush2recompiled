diff --git a/src/common/rt64_live_textures.h b/src/common/rt64_live_textures.h
new file mode 100644
index 0000000..32185dd
--- /dev/null
+++ b/src/common/rt64_live_textures.h
@@ -0,0 +1,39 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <vector>
+
+#include "rt64_load_types.h"
+
+namespace RT64 {
+    // Set by the host application to see the textures the game draws with, for building replacements for them at
+    // runtime (the recomp's automatic texture upscaling). Called on the thread that processes display lists, once per
+    // tile per draw call that samples a texture loaded from TMEM, so it must return quickly.
+    struct TextureObserver {
+        virtual ~TextureObserver() = default;
+
+        // hash is the texture's RT64 replacement hash. TMEM is the 4 KB of texture memory as the tile reads it, which
+        // decodes the way the texture cache's decoder does (TextureDecoder.hlsli) with tile, width, height and tlut.
+        // world is true when the draw call uses a perspective projection: 3D geometry, as opposed to the 2D rectangles
+        // and orthographic draws of HUDs and menus. frame is the submission frame of the draw.
+        virtual void textureDrawn(uint64_t hash, const uint8_t *TMEM, const LoadTile &tile, uint16_t width, uint16_t height,
+            uint32_t tlut, bool world, uint64_t frame) = 0;
+    };
+
+    extern std::atomic<TextureObserver *> ActiveTextureObserver;
+
+    // Live replacements: textures the host provides at runtime, without a texture pack. They take the place of the
+    // texture with the given hash unless a loaded pack replaces it, and they survive pack reloads. Several hashes can
+    // share one replacement image (contentKey, any value the host picks that identifies the image's contents), which
+    // is uploaded once. fileBytes holds a DDS or PNG file; it can be left empty when hasLiveReplacementContent says
+    // the content is already known. These do nothing (and return false) while no renderer is running.
+    bool addLiveReplacement(uint64_t hash, uint64_t contentKey, std::vector<uint8_t> fileBytes);
+    bool hasLiveReplacementContent(uint64_t contentKey);
+    void removeLiveReplacement(uint64_t hash);
+    void clearLiveReplacements();
+};
