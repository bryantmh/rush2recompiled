+    in float4 iPosition : POSITION,
+    in float4 iCubePosition : TEXCOORD0,
+    in float4 iCubeNormal : TEXCOORD1,
+    out float4 oPosition : SV_POSITION,
+    out float3 oCubePosition : TEXCOORD0,
+    out float3 oCubeNormal : TEXCOORD1)
+{
+    float4 ndcPos = iPosition;
+    ndcPos.xy -= gConstants.resolution / 2.0f;
