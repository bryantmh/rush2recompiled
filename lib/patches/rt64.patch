+    void RasterShaderCache::storeDiskCache(const ShaderDescription &desc, const RasterShaderBlobs &blobs) {
+        const std::scoped_lock lock(diskMutex);
+        if (!diskFile.is_open()) {
+            // The file is still being read: kept for the loader to write once it has the file open.
+            if (diskLoader != nullptr) {
+                diskPending.push_back({ desc, blobs });
+            }
