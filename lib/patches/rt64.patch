diff --git a/src/shaders/AmbientOcclusionApplyPS.hlsl b/src/shaders/AmbientOcclusionApplyPS.hlsl
new file mode 100644
index 0000000..d593ec5
--- /dev/null
+++ b/src/shaders/AmbientOcclusionApplyPS.hlsl
@@ -0,0 +1,39 @@
+//
+// RT64
+//
+
+// Rush 2 recomp: screen space ambient occlusion, second pass. Averages the first pass (AmbientOcclusionPS.hlsl) over
+// 4x4 pixels, which holds each of its turns once, skipping pixels at other depths so the occlusion doesn't bleed across
+// edges, and returns it for the pipeline to multiply into the color target.
+
+#include "shared/rt64_ambient_occlusion.h"
+
+[[vk::push_constant]] ConstantBuffer<AmbientOcclusionCB> gConstants : register(b0);
+
+Texture2D<float2> gOcclusion : register(t1);
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    uint width, height;
+    gOcclusion.GetDimensions(width, height);
+    const int2 maxPixel = int2(width, height) - 1;
+    const int2 pixel = clamp(int2(pos.xy), int2(0, 0), maxPixel);
+    const float2 here = gOcclusion.Load(int3(pixel, 0));
+    if (here.y >= gConstants.fadeEnd) {
+        return float4(1.0f, 1.0f, 1.0f, 1.0f);
+    }
+
+    const float tolerance = here.y * 0.04f + 0.01f;
+    float sum = 0.0f;
+    float weights = 0.0f;
+    for (int y = -2; y < 2; y++) {
+        for (int x = -2; x < 2; x++) {
+            const float2 s = gOcclusion.Load(int3(clamp(pixel + int2(x, y), int2(0, 0), maxPixel), 0));
+            const float weight = saturate(1.0f - abs(s.y - here.y) / tolerance);
+            sum += s.x * weight;
+            weights += weight;
+        }
+    }
+
+    const float ambient = (weights > 0.0f) ? (sum / weights) : here.x;
+    return float4(ambient, ambient, ambient, 1.0f);
+}
diff --git a/src/shaders/AmbientOcclusionPS.hlsl b/src/shaders/AmbientOcclusionPS.hlsl
new file mode 100644
index 0000000..74862a7
--- /dev/null
+++ b/src/shaders/AmbientOcclusionPS.hlsl
@@ -0,0 +1,110 @@
+//
+// RT64
+//
+
+// Rush 2 recomp: screen space ambient occlusion, first pass. From the depth buffer, writes each pixel's ambient light
+// (1 open, 0 enclosed) and its w to a half-float target that AmbientOcclusionApplyPS.hlsl blurs and multiplies into the
+// color target. Each pixel tests 12 points on a disc around it, turned by its place in a 4x4 tile, so the 4x4 blur of
+// the second pass averages every turn.
+
+#include "shared/rt64_ambient_occlusion.h"
+
+[[vk::push_constant]] ConstantBuffer<AmbientOcclusionCB> gConstants : register(b0);
+
+#ifdef MULTISAMPLING
+Texture2DMS<float> gDepth : register(t1);
+#else
+Texture2D<float> gDepth : register(t1);
+#endif
+
+static const uint SampleCount = 12;
+static const float BackgroundW = 65504.0f; // The largest half float.
+
+int2 depthSize() {
+    uint width, height;
+#ifdef MULTISAMPLING
+    uint samples;
+    gDepth.GetDimensions(width, height, samples);
+#else
+    gDepth.GetDimensions(width, height);
+#endif
+    return int2(width, height);
+}
+
+// The w of the depth at a pixel, or BackgroundW where nothing was drawn.
+float loadW(int2 pixel, int2 size) {
+    pixel = clamp(pixel, int2(0, 0), size - 1);
+#ifdef MULTISAMPLING
+    const float depth = gDepth.Load(pixel, 0);
+#else
+    const float depth = gDepth.Load(int3(pixel, 0));
+#endif
+    if (depth >= 0.99999f) {
+        return BackgroundW;
+    }
+
+    const float w = gConstants.depthB / (depth - gConstants.depthA);
+    return (w > 0.0f) ? min(w, BackgroundW) : BackgroundW;
+}
+
+float3 viewPosition(float2 pixel, float w) {
+    return float3((pixel - gConstants.center) / gConstants.focal, 1.0f) * w;
+}
+
+float2 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    const int2 size = depthSize();
+    const int2 pixel = int2(pos.xy);
+    const float w = loadW(pixel, size);
+    if (w >= gConstants.fadeEnd) {
+        return float2(1.0f, w);
+    }
+
+    // The surface's normal from its neighbors, taking each axis from the side nearer in depth so edges stay sharp.
+    const float2 center = float2(pixel) + 0.5f;
+    const float3 p = viewPosition(center, w);
+    const float3 left = viewPosition(center - float2(1.0f, 0.0f), loadW(pixel - int2(1, 0), size));
+    const float3 right = viewPosition(center + float2(1.0f, 0.0f), loadW(pixel + int2(1, 0), size));
+    const float3 up = viewPosition(center - float2(0.0f, 1.0f), loadW(pixel - int2(0, 1), size));
+    const float3 down = viewPosition(center + float2(0.0f, 1.0f), loadW(pixel + int2(0, 1), size));
+    const float3 dx = (abs(right.z - p.z) < abs(p.z - left.z)) ? (right - p) : (p - left);
+    const float3 dy = (abs(down.z - p.z) < abs(p.z - up.z)) ? (down - p) : (p - up);
+    float3 normal = normalize(cross(dx, dy));
+    if (dot(normal, p) > 0.0f) {
+        normal = -normal;
+    }
+
+    // The disc's radius on screen. Too small to see is left open.
+    const float radiusPixels = gConstants.radius * gConstants.focal.y / w;
+    if (radiusPixels < 1.0f) {
+        return float2(1.0f, w);
+    }
+
+    // The 4x4 ordered dither index turns the disc.
+    const uint bayer[16] = { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };
+    const uint tileIndex = bayer[(pixel.y & 3) * 4 + (pixel.x & 3)];
+    const float turn = (float(tileIndex) + 0.5f) / 16.0f * 6.2831853f;
+    const float radiusSquared = gConstants.radius * gConstants.radius;
+    const float bias = 0.25f; // Ignores gentle folds, like where two slopes of a road meet.
+    float occlusion = 0.0f;
+    for (uint i = 0; i < SampleCount; i++) {
+        const float t = (float(i) + 0.5f) / float(SampleCount);
+        const float angle = turn + float(i) * 2.3999632f;
+        const float2 offset = float2(cos(angle), sin(angle)) * (radiusPixels * t);
+        const int2 samplePixel = int2(floor(center + offset));
+        const float sampleW = loadW(samplePixel, size);
+        const float3 v = viewPosition(float2(samplePixel) + 0.5f, sampleW) - p;
+        const float vv = dot(v, v);
+        if ((sampleW >= BackgroundW) || (vv < 1e-8f)) {
+            continue;
+        }
+
+        const float cosine = dot(v, normal) * rsqrt(vv);
+        const float falloff = saturate(1.0f - vv / radiusSquared);
+        occlusion += max(cosine - bias, 0.0f) * falloff;
+    }
+
+    float ambient = 1.0f - saturate(occlusion * 4.0f / float(SampleCount)) * gConstants.strength;
+    const float fade = saturate((gConstants.fadeEnd - w) / max(gConstants.fadeEnd - gConstants.fadeStart, 1e-3f));
+    ambient = lerp(1.0f, ambient, fade);
+    return float2(ambient, w);
+}
diff --git a/src/shaders/CarReflection.hlsli b/src/shaders/CarReflection.hlsli
new file mode 100644
index 0000000..c9cdb19
--- /dev/null
+++ b/src/shaders/CarReflection.hlsli
@@ -0,0 +1,38 @@
+//
+// RT64
+//
+
+// Rush 2 recomp: car reflections (shared/rt64_car_reflection.h). The cube faces' axes, shared by CarReflectionCS.hlsl,
+// which draws them, and CarReflectionPS.hlsl, which reads them.
+
+static const uint CarReflectionFaceCount = 6;
+
+// Face f looks along `forward` (axis f / 2, negative when f is odd) with `up` towards the top of the face and `right`
+// towards its right. The right axis is mirrored with the view projection, which keeps the triangles' winding.
+void carReflectionFace(uint f, float mirror, out float3 right, out float3 up, out float3 forward) {
+    const float sign = ((f & 1) != 0) ? -1.0f : 1.0f;
+    const uint axis = f / 2;
+    forward = float3(axis == 0, axis == 1, axis == 2) * sign;
+    up = (axis == 1) ? float3(0.0f, 0.0f, sign) : float3(0.0f, 1.0f, 0.0f);
+    right = cross(forward, up) * mirror;
+}
+
+// The face a direction points into, and where it lands on that face: x to the right and y up, -1 to 1.
+uint carReflectionFaceOf(float3 d, float mirror, out float2 faceXY) {
+    const float3 a = abs(d);
+    uint f;
+    if ((a.x >= a.y) && (a.x >= a.z)) {
+        f = (d.x >= 0.0f) ? 0 : 1;
+    }
+    else if (a.y >= a.z) {
+        f = (d.y >= 0.0f) ? 2 : 3;
+    }
+    else {
+        f = (d.z >= 0.0f) ? 4 : 5;
+    }
+
+    float3 right, up, forward;
+    carReflectionFace(f, mirror, right, up, forward);
+    faceXY = float2(dot(d, right), dot(d, up)) / dot(d, forward);
+    return f;
+}
diff --git a/src/shaders/CarReflectionCS.hlsl b/src/shaders/CarReflectionCS.hlsl
new file mode 100644
index 0000000..8aed4b9
--- /dev/null
+++ b/src/shaders/CarReflectionCS.hlsl
@@ -0,0 +1,63 @@
+//
+// RT64
+//
+
+// Rush 2 recomp: car reflections, first step (shared/rt64_car_reflection.h). Puts each vertex back in the cube's space
+// from the screen position RSPProcessCS.hlsl gave it, for CarReflectionVS.hlsl, and
+// projects it to the six cube faces in the screen space the raster vertex shader expects, so the frame's own draw calls
+// draw the faces. Working from the screen position takes in everything the RSP did to the vertex (interpolation
+// included), and x, y and w are enough to invert the projection without the depth's precision loss.
+
+#include "shared/rt64_car_reflection.h"
+
+#include "CarReflection.hlsli"
+
+[[vk::push_constant]] ConstantBuffer<CarReflectionCB> gConstants : register(b0);
+StructuredBuffer<float4> srcScreenPos : register(t1);
+RWStructuredBuffer<float4> dstPos : register(u2);
+RWStructuredBuffer<float4> dstCubePos : register(u3);
+
+float safeDivide(float a, float b) {
+    return (abs(b) > 1e-12f) ? (a / b) : 0.0f;
+}
+
+[numthreads(64, 1, 1)]
+void CSMain(uint vertexIndex : SV_DispatchThreadID) {
+    if (vertexIndex >= gConstants.vertexCount) {
+        return;
+    }
+
+    // RSPProcessCS: screen = (clip.xyz / (w, -w, w)) * scale + translate.
+    const float4 screen = srcScreenPos[vertexIndex];
+    const float w = screen.w;
+    const float2 ndc = float2(safeDivide(screen.x - gConstants.viewportTranslate.x, gConstants.viewportScale.x), safeDivide(screen.y - gConstants.viewportTranslate.y, gConstants.viewportScale.y));
+    const float4 clip = float4(ndc.x * w, -ndc.y * w, w, 1.0f);
+    const float3 pos = float3(dot(clip, gConstants.invClip[0]), dot(clip, gConstants.invClip[1]), dot(clip, gConstants.invClip[2]));
+    dstPos[vertexIndex] = float4(pos, 1.0f);
+
+    if (gConstants.writeFaces == 0) {
+        return;
+    }
+
+    // Each face is a 90 degree perspective with an infinite far plane, giving depth 1 - near / w. RasterVS.hlsl turns the
+    // screen position back into clip space with the resolution: ndc.xy = (screen.xy - res / 2) / (res.x / 2, -res.y / 2).
+    const float2 halfResolution = gConstants.resolution * 0.5f;
+    for (uint f = 0; f < CarReflectionFaceCount; f++) {
+        float3 right, up, forward;
+        carReflectionFace(f, gConstants.mirror, right, up, forward);
+        float faceW = dot(pos, forward);
+        if (abs(faceW) < 1e-6f) {
+            faceW = 1e-6f;
+        }
+
+        const float nearDistance = gConstants.nearDistances[f / 2];
+        const float2 faceNdc = float2(dot(pos, right), dot(pos, up)) / faceW;
+        const float4 faceScreen = float4(
+            faceNdc.x * halfResolution.x + halfResolution.x,
+            -faceNdc.y * halfResolution.y + halfResolution.y,
+            1.0f - nearDistance / faceW,
+            faceW);
+
+        dstCubePos[f * gConstants.vertexCount + vertexIndex] = faceScreen;
+    }
+}
diff --git a/src/shaders/CarReflectionPS.hlsl b/src/shaders/CarReflectionPS.hlsl
new file mode 100644
index 0000000..828fe57
--- /dev/null
+++ b/src/shaders/CarReflectionPS.hlsl
@@ -0,0 +1,97 @@
+//
+// RT64
+//
+
+// Rush 2 recomp: car reflections (shared/rt64_car_reflection.h). Reflects the view off the paint's smooth normal into
+// the cube map and blends it over the paint by a Fresnel term: faint where the paint faces the camera, strong at
+// grazing angles. With blur, the reflection is the average of a cone of directions, like glossy paint rather than a
+// mirror, which hides how few polygons the cars have.
+
+#include "shared/rt64_car_reflection.h"
+
+#include "CarReflection.hlsli"
+
+[[vk::push_constant]] ConstantBuffer<CarReflectionDrawCB> gConstants : register(b0);
+Texture2D<float4> gCube : register(t1);
+SamplerState gSampler : register(s2);
+
+static const float BaseReflectance = 0.12f;
+
+// The cone's rings: how far each is from the reflected direction at full blur (the tangent of its angle) and how many
+// taps it has.
+static const uint BlurRings = 2;
+static const uint BlurRingTaps = 6;
+static const float BlurRingRadius = 0.14f;
+
+// A surface that faces the middle of the car (the inside of a fin) mostly reflects the car, whatever the bounds say:
+// its reflection fades out as the polygon's normal turns from across the direction to the car's center to along it.
+static const float InwardFadeStart = 0.05f;
+static const float InwardFadeEnd = 0.45f;
+
+// How far a reflection may run inside the car's bounds, as a fraction of the car's largest half size, before it starts
+// to fade and before it is gone. The cube map has no car in it, so a reflection that would hit the car (the inside of a
+// fin, the hood towards the windshield) would show the road on the car's other side instead.
+static const float SelfFadeStart = 0.3f;
+static const float SelfFadeEnd = 0.8f;
+
+// The cube map's color in a direction. Face f is at column f % 3, row f / 3; the top row of a face is y = 1. Kept half
+// a texel inside the face so the filter doesn't take in its neighbor.
+float3 sampleCube(float3 direction) {
+    float2 faceXY;
+    const uint face = carReflectionFaceOf(direction, gConstants.mirror, faceXY);
+    const float faceSize = gConstants.atlasFaceSize;
+    const float2 inFace = clamp(float2(faceXY.x, -faceXY.y) * 0.5f + 0.5f, 0.5f / faceSize, 1.0f - 0.5f / faceSize);
+    const float2 atlasUV = (float2(face % 3, face / 3) + inFace) / float2(3.0f, 2.0f);
+    return gCube.SampleLevel(gSampler, atlasUV, 0.0f).rgb;
+}
+
+float4 PSMain(in float4 pos : SV_POSITION, in float3 cubePosition : TEXCOORD0, in float3 cubeNormal : TEXCOORD1) : SV_TARGET {
+    const float3 view = normalize(cubePosition - gConstants.cameraPosition);
+
+    // The polygon's own normal, towards the camera, tells which way the smooth normal points (the triangles' winding
+    // gives it either sign). Near the car's outline the smooth normal can still lean away from the camera: it is tipped
+    // back to the outline instead of flipped, which would draw a line there.
+    float3 faceNormal = cross(ddx(cubePosition), ddy(cubePosition));
+    faceNormal = (dot(faceNormal, faceNormal) > 0.0f) ? normalize(faceNormal) : -view;
+    if (dot(faceNormal, view) > 0.0f) {
+        faceNormal = -faceNormal;
+    }
+
+    float3 normal = (dot(cubeNormal, cubeNormal) < 1e-8f) ? faceNormal : normalize(cubeNormal);
+    if (dot(normal, faceNormal) < 0.0f) {
+        normal = -normal;
+    }
+
+    const float away = dot(normal, view);
+    if (away > -0.02f) {
+        normal = normalize(normal - view * (away + 0.02f));
+    }
+
+    const float3 reflected = reflect(view, normal);
+    const float3 tangent = normalize(cross(reflected, (abs(reflected.y) < 0.9f) ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f)));
+    const float3 bitangent = cross(reflected, tangent);
+    float3 color = sampleCube(reflected);
+    if (gConstants.blur > 0.0f) {
+        for (uint ring = 0; ring < BlurRings; ring++) {
