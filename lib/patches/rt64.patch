+    void RasterShaderCache::loadDiskCache(std::filesystem::path path, uint64_t key) {
+        Thread::setCurrentThreadName("RT64 Shader Disk");
+
+        // Read every whole record; a launch that ended while writing one leaves a partial record at the end.
+        std::vector<DiskJob> jobs;
+        uint64_t validSize = 0;
+        bool headerValid = false;
+        {
+            std::ifstream file(path, std::ios::binary);
+            uint32_t magic = 0, version = 0;
+            uint64_t fileKey = 0;
+            if (file.read(reinterpret_cast<char *>(&magic), sizeof(magic)) && file.read(reinterpret_cast<char *>(&version), sizeof(version)) &&
+                file.read(reinterpret_cast<char *>(&fileKey), sizeof(fileKey)))
+            {
+                headerValid = (magic == DiskFileMagic) && (version == DiskFileVersion) && (fileKey == key);
+            }
+
+            if (headerValid) {
+                validSize = uint64_t(file.tellg());
+                while (!diskLoaderCancel) {
+                    DiskJob job;
+                    uint32_t recordMagic = 0, vsSize = 0, psSize = 0;
+                    if (!file.read(reinterpret_cast<char *>(&recordMagic), sizeof(recordMagic)) || (recordMagic != DiskRecordMagic) ||
+                        !file.read(reinterpret_cast<char *>(&job.desc), sizeof(job.desc)) ||
+                        !file.read(reinterpret_cast<char *>(&vsSize), sizeof(vsSize)) || !file.read(reinterpret_cast<char *>(&psSize), sizeof(psSize)) ||
+                        (vsSize > DiskBlobLimit) || (psSize > DiskBlobLimit))
+                    {
+                        break;
+                    }
+
+                    job.blobs.vertexShader.resize(vsSize);
+                    job.blobs.pixelShader.resize(psSize);
+                    if ((vsSize > 0) && !file.read(reinterpret_cast<char *>(job.blobs.vertexShader.data()), vsSize)) {
+                        break;
+                    }
+
+                    if ((psSize > 0) && !file.read(reinterpret_cast<char *>(job.blobs.pixelShader.data()), psSize)) {
+                        break;
+                    }
+
+                    validSize = uint64_t(file.tellg());
+                    jobs.emplace_back(std::move(job));
+                }
+            }
+        }
+
+        if (diskLoaderCancel) {
+            return;
+        }
+
+        // Open the file for appending: cut a partial record off the end, or start it over for another build.
+        std::error_code ec;
+        std::filesystem::create_directories(path.parent_path(), ec);
+        if (headerValid) {
+            if (std::filesystem::file_size(path, ec) != validSize) {
+                std::filesystem::resize_file(path, validSize, ec);
+            }
+        }
+        else {
+            jobs.clear();
+        }
+
+        std::vector<DiskJob> pending;
+        {
+            const std::scoped_lock lock(diskMutex);
+            if (headerValid) {
+                diskFile.open(path, std::ios::binary | std::ios::app);
+            }
+            else {
+                diskFile.open(path, std::ios::binary | std::ios::trunc);
+                const uint32_t version = DiskFileVersion;
+                diskFile.write(reinterpret_cast<const char *>(&DiskFileMagic), sizeof(DiskFileMagic));
+                diskFile.write(reinterpret_cast<const char *>(&version), sizeof(version));
+                diskFile.write(reinterpret_cast<const char *>(&key), sizeof(key));
+                diskFile.flush();
+            }
+
+            for (const DiskJob &job : jobs) {
+                diskHashes.insert(job.desc.hash());
+            }
+
+            // Shaders compiled while the file was being read.
+            pending.swap(diskPending);
+        }
+
+        for (const DiskJob &job : pending) {
+            storeDiskCache(job.desc, job.blobs);
+        }
+
+        // Queue the cached shaders the game hasn't asked for yet.
+        uint32_t queued = 0;
+        {
+            const std::unique_lock<std::mutex> submissionLock(submissionMutex);
+            const std::unique_lock<std::mutex> queueLock(descQueueMutex);
+            for (DiskJob &job : jobs) {
+                bool &found = shaderHashes[job.desc.hash()];
+                if (!found) {
+                    found = true;
+                    diskQueue.push(std::move(job));
+                    queued++;
+                }
+            }
+
+            diskRemaining = int32_t(queued);
+        }
+
+        fprintf(stderr, "[rt64] shader cache: %zu shaders in %s, %u to build\n", jobs.size(), path.filename().string().c_str(), queued);
+        if (queued > 0) {
+            descQueueChanged.notify_all();
+        }
+    }
