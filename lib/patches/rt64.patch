diff --git a/src/common/rt64_live_textures.h b/src/common/rt64_live_textures.h
new file mode 100644
index 0000000..c8ad7b6
--- /dev/null
+++ b/src/common/rt64_live_textures.h
@@ -0,0 +1,76 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <vector>
+
+#include "rt64_load_types.h"
+
+namespace RT64 {
+    // Set by the host application to see the textures the game draws with, for building replacements for them at
+    // runtime (the recomp's automatic texture upscaling). Called on the thread that processes display lists, once per
+    // tile per draw call that samples a texture loaded from TMEM, so it must return quickly.
+    struct TextureObserver {
+        virtual ~TextureObserver() = default;
+
+        // hash is the texture's RT64 replacement hash. TMEM is the 4 KB of texture memory as the tile reads it, which
+        // decodes the way the texture cache's decoder does (TextureDecoder.hlsli) with tile, width, height and tlut.
+        // world is true when the draw call uses a perspective projection: 3D geometry, as opposed to the 2D rectangles
+        // and orthographic draws of HUDs and menus. frame is the submission frame of the draw. address is the RDRAM
+        // address the last load into the tile's TMEM address read its texels from (as the load gave it).
+        virtual void textureDrawn(uint64_t hash, const uint8_t *TMEM, const LoadTile &tile, uint16_t width, uint16_t height,
+            uint32_t tlut, bool world, uint64_t frame, uint32_t address) = 0;
+    };
+
+    extern std::atomic<TextureObserver *> ActiveTextureObserver;
+
+    // The part of a larger image that a replaced texture is: the texture the game loaded holds the texels at (x, y) of
+    // an image sourceWidth x sourceHeight texels in size (in the game's texels), and the replacement image is all of
+    // it. A game that loads a texture in strips gets one replacement per strip, all sharing the image, and filtering
+    // at a strip's edge then reads the image's next texels instead of wrapping around the strip. A sourceWidth of 0
+    // means the replacement is the loaded texture alone.
+    struct ReplacementRegion {
+        uint32_t x = 0;
+        uint32_t y = 0;
+        uint32_t sourceWidth = 0;
+        uint32_t sourceHeight = 0;
+
+        bool isWhole() const {
+            return sourceWidth == 0;
+        }
+    };
+
+    // Live replacements: textures the host provides at runtime, without a texture pack. They take the place of the
+    // texture with the given hash unless a loaded pack replaces it, and they survive pack reloads. Several hashes can
+    // share one replacement image (contentKey, any value the host picks that identifies the image's contents), which
+    // is uploaded once. fileBytes holds a DDS or PNG file; it can be left empty when hasLiveReplacementContent says
+    // the content is already known. These do nothing (and return false) while no renderer is running.
+    // region is the part of the image the hash's texture is (see ReplacementRegion).
+    bool addLiveReplacement(uint64_t hash, uint64_t contentKey, std::vector<uint8_t> fileBytes, ReplacementRegion region = {});
+    bool hasLiveReplacementContent(uint64_t contentKey);
+    void removeLiveReplacement(uint64_t hash);
+    void clearLiveReplacements();
+
+    // Rush 2 recomp: texture prewarming. A texture the game loads for the first time is uploaded (and decoded on the
+    // GPU) while its frame waits; a race's first frame brings hundreds. The host records what the texture cache
+    // uploads (TextureUploadObserver, called on the thread that processes display lists for each texture uploaded for
+    // the first time, with TMEM's 4 KB) and hands the same uploads back ahead of time (prewarmTexture: queued behind
+    // the game's own uploads and done in small batches, so no frame waits on them). A prewarmed texture is kept until
+    // the game draws with it, or until unpinPrewarmedTextures lets the ones still unused age out as any texture does.
+    struct TextureUploadObserver {
+        virtual ~TextureUploadObserver() = default;
+        virtual void textureUploaded(uint64_t hash, const uint8_t *TMEM, uint16_t width, uint16_t height, uint32_t tlut,
+            const LoadTile &tile, bool decodeTMEM) = 0;
+    };
+
+    extern std::atomic<TextureUploadObserver *> ActiveTextureUploadObserver;
+
+    bool prewarmTexture(uint64_t hash, std::vector<uint8_t> TMEM, uint16_t width, uint16_t height, uint32_t tlut, const LoadTile &tile, bool decodeTMEM);
+    void unpinPrewarmedTextures();
+    // Whether the texture cache holds the texture with this hash now.
+    bool hasCachedTexture(uint64_t hash);
+};
