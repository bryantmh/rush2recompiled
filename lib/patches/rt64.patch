+//
+// RT64
+//
+
+#pragma once
+
+#include "shared/rt64_hlsl.h"
+
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+    // Rush 2 recomp: car reflections (FramebufferRenderer::submitCarReflection). The paint of the cars a game marks with
+    // gEXSetCarReflection reflects a cube map drawn from the frame's own 3D draws around the nearest marked car. The
+    // cube's space is the space the world transforms put vertices in, moved so the car's center is the origin. Its six
+    // faces are laid out 3 x 2 in one atlas: face f (axis f / 2, negative when f is odd) at column f % 3, row f / 3.
+
+    // CarReflectionCS.hlsl: puts each vertex back in the cube's space from its screen position and projects it to the six
+    // faces.
+    struct CarReflectionCB {
+        // A vertex's position in the cube's space is dot(float4(clip.x, clip.y, clip.w, 1), invClip[i]) for each axis i:
+        // the view projection's x, y and w columns inverted, less the car's center.
+        float4 invClip[3];
+        // The screen position's viewport, as the RSP applied it.
+        float3 viewportScale;
+        uint vertexCount;
+        float3 viewportTranslate;
+        // -1 when the view projection mirrors (the faces mirror too so triangles keep their winding), 1 otherwise.
+        float mirror;
+        // The faces' near planes along each axis: past the car's bounds, so the car doesn't reflect itself.
+        float3 nearDistances;
+        // Nonzero when the cube map is drawn this frame: the faces' positions are only written then.
+        uint writeFaces;
+        // The screen positions the raster vertex shader turns into clip space (FramebufferParams::resolution).
+        float2 resolution;
+        float2 padding1;
+    };
+
+    // CarReflectionVS.hlsl / CarReflectionPS.hlsl: draws a marked draw's triangles reflecting the cube map.
+    struct CarReflectionDrawCB {
+        float2 resolution;
+        float2 screenScale;
+        float2 screenOffset;
+        // The size of one face in the atlas, in pixels.
+        float atlasFaceSize;
+        // How much of the reflection covers the paint, 0 to 1.
+        float strength;
+        // The camera, in the cube's space.
+        float3 cameraPosition;
+        float mirror;
+        // The bounds of the car the draw is part of, in the cube's space: a reflection that crosses them would show the
+        // car itself, which the cube map leaves out, so it fades out (CarReflectionPS.hlsl).
+        float3 carMin;
+        // How wide the cone of directions a reflection averages is, 0 (one direction, a mirror) to 1.
+        float blur;
+        float3 carMax;
+        float padding0;
+    };
+#ifdef HLSL_CPU
+};
+#endif
