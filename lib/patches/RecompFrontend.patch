+
+// Lists the provider's notes on the shown mod, rebuilding only when they change, and asks again next frame while the
+// provider is still working them out.
+void ModDetailsPanel::refresh_notes() {
+    ModNotes notes;
+    {
+        std::lock_guard lock{ notes_mutex };
+        if (notes_provider) notes = notes_provider(cur_details.mod_id);
+    }
+    // mod.json problems that were filled in with defaults come first.
+    if (!cur_details.manifest_warnings.empty()) {
+        ModNoteSection manifest_section;
+        manifest_section.title = "mod.json";
+        for (const std::string& w : cur_details.manifest_warnings) {
+            ModNote note;
+            note.level = ModNote::Level::Warning;
+            note.text = w;
+            manifest_section.notes.push_back(std::move(note));
+        }
+        notes.sections.insert(notes.sections.begin(), std::move(manifest_section));
+    }
+    std::string signature = cur_details.mod_id + (notes.pending ? ";pending;" : ";");
+    for (const ModNoteSection& s : notes.sections) {
+        signature += s.title + "\n";
+        for (const ModNote& n : s.notes) signature += std::to_string(int(n.level)) + n.text + "\n";
+    }
+    if (signature != notes_signature) {
+        notes_signature = signature;
+        notes_container->clear_children();
+        ContextId context = get_current_context();
+        for (const ModNoteSection& s : notes.sections) {
+            Label* title = context.create_element<Label>(notes_container, s.title, LabelStyle::Normal);
+            title->set_margin_top(16.0f);
+            for (const ModNote& n : s.notes) {
+                const char* tag = n.level == ModNote::Level::Error ? "Problem: " : n.level == ModNote::Level::Warning ? "Warning: " : "";
+                theme::color color = n.level == ModNote::Level::Error ? theme::color::DangerL
+                                   : n.level == ModNote::Level::Warning ? theme::color::WarningL : theme::color::TextDim;
+                context.create_element<ModNoteLine>(notes_container, tag + n.text, LabelStyle::Small, color);
+            }
+        }
+    }
+    if (notes.pending) queue_update();
 }
 
