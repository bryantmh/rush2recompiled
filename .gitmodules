[submodule "lib/rt64"]
	path = lib/rt64
	url = https://github.com/rt64/rt64
	ignore = dirty
[submodule "lib/N64ModernRuntime"]
	path = lib/N64ModernRuntime
	url = https://github.com/N64Recomp/N64ModernRuntime
	ignore = dirty
[submodule "lib/RecompFrontend"]
	path = lib/RecompFrontend
	url = https://github.com/N64Recomp/RecompFrontend
	ignore = dirty
[submodule "lib/enet"]
	path = lib/enet
	url = https://github.com/lsalzman/enet
	ignore = dirty
[submodule "lib/miniupnp"]
	path = lib/miniupnp
	url = https://github.com/miniupnp/miniupnp
	ignore = dirty
[submodule "lib/Clipper2"]
	path = lib/Clipper2
	url = https://github.com/AngusJohnson/Clipper2
	ignore = dirty
[submodule "lib/earcut"]
	path = lib/earcut
	url = https://github.com/mapbox/earcut.hpp
	ignore = dirty
